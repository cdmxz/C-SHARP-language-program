<Page x:Class="翻译神器WPF.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:翻译神器WPF.Controls"
      xmlns:converters="clr-namespace:翻译神器WPF.Converters"
      xmlns:viewmodels="clr-namespace:翻译神器WPF.ViewModels"
      d:DataContext="{d:DesignInstance Type=viewmodels:SettingsPageViewModel,IsDesignTimeCreatable=True}"
      mc:Ignorable="d"
      d:DesignHeight="600"
      d:DesignWidth="500"
      Title="SettingsView">
    <Page.Resources>
        <Style TargetType="CheckBox"
               BasedOn="{StaticResource ResourceKey={x:Type CheckBox}}">
            <Setter Property="Margin"
                    Value="5" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="TitleText"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="20" />
            <Setter Property="FontWeight"
                    Value="Bold" />
        </Style>

        <Style x:Key="BackBorder"
               TargetType="Border">
            <Setter Property="BorderBrush"
                    Value="DarkGray" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="3" />
            <Setter Property="Padding"
                    Value="5,10" />
            <Setter Property="Margin"
                    Value="0,10" />
        </Style>

        <converters:RectangleToStringConverter x:Key="RectangleToStringConverter" />
        <!-- 新增：数值取整转换器 -->
        <converters:RoundToIntConverter x:Key="RoundToInt" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="10,0">
        <StackPanel>
            <TextBlock Text="热键"
                       Style="{StaticResource TitleText}"
                       Margin="0,10,0,0" />
            <Border Style="{StaticResource BackBorder}">
                <WrapPanel>
                    <controls:YTextBox Tip="截图热键："
                                       VerticalAlignment="Center"
                                       IsReceiveKey="True"
                                       ToolTip="鼠标双击清除热键"
                                       Text="{Binding SettingsData.ScreenshotHotKey,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="InvalidInput">
                                <i:InvokeCommandAction Command="{Binding YTextBox_InvalidInputCommand}"
                                                       PassEventArgsToCommand="True" />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding YTextBoxLostFocusCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </controls:YTextBox>

                    <controls:YTextBox Tip="固定翻译热键："
                                       VerticalAlignment="Center"
                                       IsReceiveKey="True"
                                       ToolTip="鼠标双击清除热键"
                                       Text="{Binding SettingsData.FixedHotKey,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="InvalidInput">
                                <i:InvokeCommandAction Command="{Binding YTextBox_InvalidInputCommand}"
                                                       PassEventArgsToCommand="True" />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding YTextBoxLostFocusCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </controls:YTextBox>

                </WrapPanel>
            </Border>

            <TextBlock Text="翻译"
                       Style="{StaticResource TitleText}"
                       Margin="0,10,0,0" />
            <Border Style="{StaticResource BackBorder}">
                <WrapPanel>
                    <TextBlock Text="翻译接口："
                               VerticalAlignment="Center"
                               Margin="10 0 5 0" />
                    <ComboBox ToolTip="切换语言"
                              MinWidth="120"
                              SelectedIndex="{Binding SettingsData.SelectedApiIndex}"
                              ItemsSource="{Binding AllApiNames}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ExecuteCommand}"
                                                       CommandParameter="ApiSelectionChanged" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <TextBlock Text="目标语言："
                               VerticalAlignment="Center"
                               Margin="30 0 5 0" />
                    <ComboBox ToolTip="切换语言"
                              MinWidth="120"
                              SelectedIndex="{Binding SettingsData.SelectedLanguageIndex}"
                              ItemsSource="{Binding AllLanguageNames}">
                    </ComboBox>
                    <CheckBox Content="复制原文"
                              IsChecked="{Binding SettingsData.IsCopyOriginalText}" />
                    <CheckBox Content="复制译文"
                              IsChecked="{Binding SettingsData.IsCopyTranText}" />
                    <CheckBox Content="翻译后朗读译文"
                              IsChecked="{Binding SettingsData.IsReadingAloud}"
                              Command="{Binding ExecuteCommand}"
                              CommandParameter="ReadingAloudChanged" />
                    <CheckBox Content="添加自启动"
                              IsChecked="{Binding IsAddedAutoStart}"
                              Command="{Binding ExecuteCommand}"
                              CommandParameter="AutoStartToggle">
                    </CheckBox>
                </WrapPanel>
            </Border>

            <TextBlock Text="译文窗口"
                       Style="{StaticResource TitleText}"
                       Margin="0,10,0,0" />
            <Border Style="{StaticResource BackBorder}">
                <WrapPanel Margin="5 0 0 0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="延迟"
                                   VerticalAlignment="Center" />
                        <controls:YNumBox Margin="5,0"
                                          Width="100"
                                          Value="{Binding SettingsData.DelayTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Minimum="0"
                                          Maximum="999" />
                        <TextBlock Text="秒关闭译文窗口"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="25,0,0,0">
                        <TextBlock Text="窗口位置"
                                   VerticalAlignment="Center" />
                        <ComboBox Margin="5 0 0 0"
                                  ToolTip="窗口位置"
                                  MinWidth="120"
                                  Text="屏幕顶部"
                                  SelectedItem="{Binding SettingsData.SelectedTextWindowLocation}"
                                  ItemsSource="{Binding TextWindowLocations}" />
                    </StackPanel>
                    <controls:YSlider Margin="0,10"
                                      Text="透明度"
                                      SmallChange="0.1"
                                      MaxValue="1"
                                      MinValue="0"
                                      Width="200"
                                      Value="{Binding SettingsData.TextWindowOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ValueChangedCommand="{Binding OpacityChangedCommand}" />
                    <controls:YSlider Margin="20,10,0,10"
                                      Text="字体大小"
                                      SmallChange="1"
                                      MaxValue="40"
                                      MinValue="10"
                                      Width="200"
                                      Value="{Binding SettingsData.TextWindowFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource RoundToInt}}"
                                      ValueChangedCommand="{Binding FontSizeChangedCommand}" />
                    <Expander ExpandDirection="Down"
                              IsExpanded="False">
                        <Expander.Header>
                            窗口背景颜色
                        </Expander.Header>
                        <Expander.Content>
                            <controls:YColorPicker SelectedColor="{Binding  SettingsData.TextBgColor, Mode=TwoWay}"
                                                   ColorChangedCommand="{Binding ColorChangedCommand}" />

                        </Expander.Content>
                    </Expander>
                </WrapPanel>
            </Border>
            <TextBlock Text="固定翻译"
                       Style="{StaticResource TitleText}"
                       Margin="0,10,0,0" />
            <Border Style="{StaticResource BackBorder}">
                <WrapPanel>
                    <TextBlock Margin="5,0,0,0"
                               Text="固定截图区域"
                               FontSize="14"
                               VerticalAlignment="Center" />
                    <TextBlock Margin="5"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="Gray">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"
                                        Value="未设置" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=SettingsData.Rect.IsEmpty}"
                                                 Value="False">
                                        <Setter Property="Text"
                                                Value="{Binding Path=SettingsData.Rect,Converter={StaticResource ResourceKey=RectangleToStringConverter}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Margin="5"
                            Padding="8"
                            Content="设置固定截图区域"
                            Command="{Binding ExecuteCommand}"
                            CommandParameter="SetFixedArea" />
                </WrapPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
