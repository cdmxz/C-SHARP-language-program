<Window x:Class="翻译神器WPF.TextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewmodels="clr-namespace:翻译神器WPF.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:翻译神器WPF"
        xmlns:converters="clr-namespace:翻译神器WPF.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:TextWindowViewModel, IsDesignTimeCreatable=True}"
        Title="TextWindow"
        MaxHeight="{Binding MaxWindowHeight}"
        MaxWidth="{Binding MaxWindowWidth}"
        Height="{Binding SettingsData.TextWindowHeight,Mode=TwoWay}"
        Width="{Binding SettingsData.TextWindowWidth,Mode=TwoWay}"
        MinHeight="{Binding MinWindowHeight}"
        MinWidth="{Binding MinWindowWidth}"
        Left="{Binding SettingsData.TextWindowLeft, Mode=TwoWay}"
        Top="{Binding SettingsData.TextWindowTop, Mode=TwoWay}"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="{Binding ResizeMode}"
        SizeToContent="{Binding SizeToContent}"
        Closing="Window_Closing"
        Topmost="{Binding SettingsData.IsTextWindowTopmost}"
        IsVisibleChanged="Window_IsVisibleChanged"
        ShowInTaskbar="False">


    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome ResizeBorderThickness="10"
                            CaptionHeight="0"
                            CornerRadius="8"
                            GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Background>
        <SolidColorBrush Opacity="{Binding SettingsData.TextWindowOpacity}"
                         Color="{Binding SettingsData.TextBgColor}" />
    </Window.Background>

    <Window.Resources>
        <Style x:Key="BaseButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="5" />
            <Style.Triggers>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Padding"
                    Value="8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Foreground"
                            Value="Red" />
                    <Setter Property="Background"
                            Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:TopmostToStringConverter x:Key="TopmostToStringConverter" />

    </Window.Resources>

    <Border BorderBrush="#FFA7C6DB"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding TitleHeight}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--标题栏-->
            <Border BorderBrush="DarkGray"
                    BorderThickness="0 0 0 1">
                <DockPanel MouseLeftButtonDown="DockPanel_MouseLeftButtonDown"
                           Background="Transparent">
                    <TextBlock Text="翻译神器-文本窗口"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Foreground="AliceBlue" />

                    <Button x:Name="CloseButton"
                            Width="32"
                            Style="{StaticResource CloseButtonStyle}"
                            Content="X"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click" />
                </DockPanel>
            </Border>

            <!--内容-->
            <ScrollViewer Grid.Row="1"
                          Padding="8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Width="Auto">
                <TextBlock Text="{Binding Text}"
                           Foreground="White"
                           FontSize="{Binding SettingsData.TextWindowFontSize}"
                           TextWrapping="Wrap">
                    <TextBlock.InputBindings>
                        <MouseBinding Command="{Binding DoubleClickTextCommand}"
                                      MouseAction="LeftDoubleClick" />
                    </TextBlock.InputBindings>
                    
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseRightButtonUp">
                            <i:InvokeCommandAction Command="{Binding MouseRightButtonUpCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                    <TextBlock.ContextMenu>
                        <ContextMenu HasDropShadow="True"
                                     FontSize="15"
                                     Visibility="{Binding IsShowTitleBar, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <MenuItem Header="复制"
                                      Command="{Binding ContextMenuCommand}"
                                      CommandParameter="Copy" />
                            <MenuItem Header="{Binding SettingsData.IsTextWindowTopmost, Converter={StaticResource TopmostToStringConverter}}"
                                      Command="{Binding ContextMenuCommand}"
                                      CommandParameter="Topmost" />
                            <MenuItem Header="关闭窗口"
                                      Command="{Binding ContextMenuCommand}"
                                      CommandParameter="Hide" />
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
