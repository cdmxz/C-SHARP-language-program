<Page x:Class="翻译神器WPF.Views.KeyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:翻译神器WPF.Views"
      xmlns:controls="clr-namespace:翻译神器WPF.Controls"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:viewmodels="clr-namespace:翻译神器WPF.ViewModels"
      d:DataContext="{d:DesignInstance Type=viewmodels:KeyPageViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="400"
      d:DesignWidth="500"
      Title="KeyView">

    <Page.Resources>
        <Style x:Key="TitleText"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="20" />
            <Setter Property="FontWeight"
                    Value="Bold" />
        </Style>

        <Style x:Key="BackBorder"
               TargetType="Border">
            <Setter Property="BorderBrush"
                    Value="DarkGray" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="3" />
            <Setter Property="Padding"
                    Value="8,10" />
            <Setter Property="Margin"
                    Value="0,10" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="10,0">

        <StackPanel>
            <TextBlock Text="百度API"
                       Style="{StaticResource TitleText}"
                       Margin="0,10,0,0" />
            <Border Style="{StaticResource BackBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="55" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="图片翻译APP ID" />
                    <TextBox Grid.Column="1"
                             Text="{Binding KeyData.BaiduKey.AppId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                             Margin="5" />

                    <TextBlock Grid.Row="1"
                               Text="图片翻译密钥" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Margin="5"
                             Text="{Binding KeyData.BaiduKey.Password,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="2"
                            Grid.Row="1"
                            Content="测试"
                            Command="{Binding TestApiCommand}"
                            CommandParameter="Baidu" />
                </Grid>
            </Border>

            <TextBlock Text="有道API"
                       Style="{StaticResource TitleText}"
                       Margin="0,10,0,0" />
            <Border Style="{StaticResource BackBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="55" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="图片翻译应用ID" />
                    <TextBox Grid.Column="1"
                             Text="{Binding KeyData.YoudaoKey.AppKey,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                             Margin="5" />

                    <TextBlock Grid.Row="1"
                               Text="图片翻译密钥" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Margin="5"
                             Text="{Binding KeyData.YoudaoKey.AppSecret,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="2"
                            Grid.Row="1"
                            Content="测试"
                            Command="{Binding TestApiCommand}"
                            CommandParameter="YouDao" />
                </Grid>
            </Border>

            <TextBlock Text="腾讯API"
                       Style="{StaticResource TitleText}"
                       Margin="0,10,0,0" />
            <Border Style="{StaticResource BackBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="55" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="图片翻译Secretld" />
                    <TextBox Grid.Column="1"
                             Text="{Binding KeyData.TengxunKey.SecretId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                             Margin="5" />

                    <TextBlock Grid.Row="1"
                               Text="图片翻译应用密钥" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Margin="5"
                             Text="{Binding KeyData.TengxunKey.SecretKey,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="2"
                            Grid.Row="1"
                            Content="测试"
                            Command="{Binding TestApiCommand}"
                            CommandParameter="TengXun" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
