<UserControl x:Class="翻译神器WPF.Controls.YSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:翻译神器WPF.Controls"
             mc:Ignorable="d"
             d:DesignHeight="50"
             d:DesignWidth="150"
             d:DataContext="{d:DesignInstance Type=local:YSlider, IsDesignTimeCreatable=True}">


    <Grid x:Name="panel"
          VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{Binding Text}"
                   VerticalAlignment="Center"
                   Margin="0,0,5,0" />
        <Slider Grid.Column="1"
                x:Name="Slider"
                Value="{Binding Value,Mode=TwoWay}"
                Minimum="{Binding MinValue}"
                Maximum="{Binding MaxValue}"
                SmallChange="{Binding SmallChange}"
                TickFrequency="{Binding SmallChange}"
                IsSnapToTickEnabled="True"
                MinWidth="100" />
        <TextBlock Grid.Column="2"
                   Text="{Binding ElementName=Slider,Path=Value, StringFormat={}{0:0.0}}"
                   VerticalAlignment="Center"
                   Margin="5,0" />
    </Grid>
</UserControl>
