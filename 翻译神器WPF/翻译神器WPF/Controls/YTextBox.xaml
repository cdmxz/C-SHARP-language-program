<UserControl x:Class="翻译神器WPF.Controls.YTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:翻译神器WPF.Controls"
             d:DataContext="{d:DesignInstance Type=local:YTextBox, IsDesignTimeCreatable=True}"
             mc:Ignorable="d"
             d:DesignHeight="40"
             d:DesignWidth="200">

    <StackPanel x:Name="panel"
                Orientation="Horizontal">
        <TextBlock Text="{Binding Tip}"
                   VerticalAlignment="Center"
                   FontSize="16"
                   Margin="5,0" />
        <TextBox x:Name="TextBox"
                 Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}"
                 Width="{Binding TextWidth}"
                 MinWidth="120"
                 ContextMenu="{x:Null}"
                 PreviewKeyDown="TextBox_PreviewKeyDown"
                 PreviewMouseDoubleClick="TextBox_PreviewMouseDoubleClick"
                 LostFocus="TextBox_LostFocus"
                 Cursor="IBeam" />
    </StackPanel>
</UserControl>
